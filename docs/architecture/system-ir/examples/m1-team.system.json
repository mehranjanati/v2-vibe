{
  "apiVersion": "vibesdk/v1",
  "kind": "System",
  "metadata": {
    "description": "IR v1 case 2 (M1): coordinator delegates, worker drafts, reviewer gates.",
    "license": "Apache-2.0",
    "name": "m1-qualify-then-draft",
    "publisher": "vibesdk",
    "version": "1.0.0"
  },
  "spec": {
    "agents": {
      "coordinator": {
        "delegatesTo": [
          "drafter"
        ],
        "ref": "agent/lead-qualifier@1.2.0"
      },
      "drafter": {
        "ref": "agent/followup-drafter@0.9.0"
      },
      "reviewer": {
        "ref": "agent/draft-reviewer@0.4.0"
      }
    },
    "approvals": [
      {
        "approver": "role:sales-lead",
        "on": "external-message"
      }
    ],
    "deployment": {
      "environment": "staging"
    },
    "outcome": "Qualify a lead, draft a follow-up, gate the draft behind review",
    "routing": {
      "onError": "escalate-human",
      "parallel": false
    },
    "topology": [
      {
        "on": "ingress.lead",
        "run": "coordinator"
      },
      {
        "after": "coordinator",
        "run": "drafter",
        "when": "verdict == \"qualified\""
      },
      {
        "after": "drafter",
        "run": "reviewer"
      }
    ]
  }
}
