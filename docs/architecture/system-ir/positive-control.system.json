{
  "apiVersion": "vibesdk/v1",
  "kind": "System",
  "metadata": {
    "description": "Positive control for ADI-FOUND-001a: every optional IR v1 field populated, so a tightened rule cannot over-reject.",
    "labels": {
      "domain": "sales",
      "tier": "reference"
    },
    "license": "Apache-2.0",
    "name": "parity-positive-control",
    "publisher": "vibesdk",
    "version": "2.1.0"
  },
  "spec": {
    "agents": {
      "coordinator": {
        "delegatesTo": [
          "drafter"
        ],
        "ref": "agent/lead-qualifier@1.2.0"
      },
      "drafter": {
        "ref": "agent/followup-drafter@0.9.0"
      }
    },
    "approvals": [
      {
        "approver": "role:sales-lead",
        "on": "external-message"
      },
      {
        "approver": "user:owner",
        "on": "external-write"
      },
      {
        "approver": "group:finance",
        "on": "payment"
      },
      {
        "approver": "role:reviewer",
        "on": "human-review"
      }
    ],
    "deployment": {
      "environment": "production",
      "replicas": 2
    },
    "evaluation": {
      "dataset": "eval/lead-quality@1.0.0",
      "thresholds": {
        "accuracy": 0.9,
        "cost": 0.4
      }
    },
    "outcome": "Qualify inbound leads and draft a follow-up that is gated behind review",
    "routing": {
      "onError": "escalate-human",
      "parallel": false
    },
    "topology": [
      {
        "on": "ingress.lead",
        "run": "coordinator"
      },
      {
        "after": "coordinator",
        "run": "drafter",
        "when": "verdict == \"qualified\""
      }
    ]
  }
}
