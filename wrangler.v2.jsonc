/**
 * V2 vibe - Fresh deploy config for a lightweight Worker.
 *
 * Deploys a NEW Worker (vibesdk-v2) from a minimal entry point that only
 * serves the frontend + auth/OAuth routes. The dependency set stays minimal
 * to keep startup time and CPU per request low on the Workers Free plan
 * (10 ms CPU/request). Note: the old "3 MB free / 10 MB paid compressed"
 * script limit was removed on 2026-09-04 — the platform now checks 64 MiB of
 * uncompressed bundle on all plans (see docs/CF_LIMITS.md §4). Avoided heavy
 * deps: CodeGen DO, ThinkAgent, SpaceDO, containers, sandbox, dispatch.
 *
 * Bindings:
 *   - D1 → v2-vibe   (374acf0b-5a29-4e1a-8b71-dc0e7178f4bd)
 *   - KV  → VibecoderStore (56d249930a4447ee92493a7ff061a3ae)
 *   - R2  → vibesdk-templates
 *   - AI binding (free)
 *   - Workflows → vibesdk-v2-workflows (class: VibeWorkflow, the DAG schema
 *     v2 interpreter backed by the workflow_* D1 tables)
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibesdk-v2",
	"main": "worker/light-index.ts",
	"compatibility_date": "2026-05-23",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "v2-vibe",
			"database_id": "374acf0b-5a29-4e1a-8b71-dc0e7178f4bd"
		}
	],
	"kv_namespaces": [
		{
			"binding": "VibecoderStore",
			"id": "56d249930a4447ee92493a7ff061a3ae"
		}
	],
	// NOTE: R2 binding removed — TEMPLATES_BUCKET is never accessed at
	// runtime by the light worker, and R2 is not yet enabled on this
	// account (error 10042). Re-add when R2 is enabled in the dashboard.
	"workflows": [
		{
			"binding": "WORKFLOWS",
			"name": "vibesdk-v2-workflows",
			"class_name": "VibeWorkflow"
		}
	],
	"vars": {
		"TEMPLATES_REPOSITORY": "https://github.com/cloudflare/vibesdk-templates",
		"CLOUDFLARE_AI_GATEWAY": "v2-vibe",
		"CUSTOM_DOMAIN": "vibesdk-v2.apjkala25.workers.dev",
		"CONTROL_PLANE_URL": "http://localhost:8080"
	},
	"workers_dev": true,
	"preview_urls": true
}