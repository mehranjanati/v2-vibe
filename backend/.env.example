# VibeSDK Go Backend configuration
# Copy to .env and adjust as needed.

# ---- Redis ----
# Either a bare host:port (docker compose) or a full connection URL with
# credentials/TLS, which managed providers hand out:
#   redis://red-xxxx:6379              Render Key Value, internal
#   redis://default:pass@host:6379     authenticated
#   rediss://default:pass@host:6379    TLS
# backend/cmd/main.go parses both forms (go-redis ParseURL).
REDIS_URL=localhost:6379

# ---- HTTP server ----
PORT=8080

# ---- CORS ----
# Browser origins allowed to call this plane. The built-in list covers the Vite
# dev servers and the known workers.dev dashboard hosts; add deployment-specific
# origins here (comma-separated, scheme + host, no trailing slash). Render sets
# the same variable in render.yaml.
# CORS_ALLOWED_ORIGINS=https://vibesdk-v2.<account>.workers.dev

# Optional: override the host used when building the WebSocket URL returned
# to the React frontend. Defaults to the incoming request host, then
# localhost:8080.
# WS_HOST=localhost:8080

# ---- LLM / AI Gateway (OpenAI-compatible SSE endpoint) ----
# Required for code generation:
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>
# IMPORTANT: use a STATIC Cloudflare API Token with "Workers AI" (and AI Gateway)
# permissions — Account > API Tokens > Create Token. Do NOT paste the short-lived
# OAuth token produced by `wrangler login` (e.g. via scripts/cf-token-login.sh);
# it expires within hours and causes repeated HTTP 401 responses from the gateway.
AI_GATEWAY_API_KEY=your-api-key-here

# Optional: model override for the default (single-model fallback)
# pipeline. The code default in pkg/llm is @cf/meta/llama-3.3-70b-instruct-fp8-fast.
# DEFAULT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---- Skills: per-role system prompts (backend/skills/) ----
# The dual-model pipeline loads planner/coder system prompts from a
# "skills" directory (01_planner.md / 02_coder.md). The location is
# probed relative to the working directory and can be pinned here;
# inside the container it lives at /app/skills (see Dockerfile).
# SKILLS_DIR=skills
# Per-role model / parameter overrides (defaults in backend/pkg/skills
# and backend/docs/architecture-roadmap.json):
# PLANNER_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# PLANNER_MAX_TOKENS=8192
# PLANNER_TEMPERATURE=0.2
# CODER_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
# CODER_MAX_TOKENS=8192
# CODER_TEMPERATURE=0.1

# ---- Cloudflare Pages deployment ----
# Cloudflare credentials live in the REPO-ROOT .env (single source of truth):
# CLOUDFLARE_ACCOUNT_ID, D1_DATABASE_ID and CLOUDFLARE_API_TOKEN. Run
# `bun run d1:token` to fill the token: it reads the fresh OAuth token from
# `wrangler login`, validates it with a read-only D1 SELECT 1, and writes it
# into .env (re-run when it expires, or paste a static "Account > D1 > Edit"
# token once for a durable setup). cmd/main.go loads .env, ../.env and
# backend/.env, so both run modes work; backend/.env only carries
# backend-specific overrides. In Docker, `docker compose up -d backend`
# re-reads the root .env (a config change recreates the container).
# Required for POST /api/projects/:id/deploy. NEVER expose these to the
# frontend bundle — they stay server-side only.
# Cloudflare credentials live in the repo-root `.env`, not here: `cmd/main.go`
# loads `.env`, `../.env` and `backend/.env` (existing process env wins, then
# backend/.env, then the root .env) and the root file is the single source of
# truth, kept fresh by `bun run d1:token`. Leaving these unset here lets the
# root values win.
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# D1_DATABASE_ID=   # must match wrangler.v2.jsonc d1_databases[0].database_id

# Optional: the Pages project name to deploy to. Defaults to
# "vibesdk-<chatId>" when unset.
# CLOUDFLARE_PAGES_PROJECT=my-pages-project

# ---- Workflow runs (POST /api/workflows/trigger) ----
# Name of the account's Cloudflare Workflow that executes generated DAGs
# (wrangler.v2.jsonc [[workflows]] → the VibeWorkflow class). The API token
# needs Workflows edit permission in addition to the Pages/D1 grants.
# WORKFLOWS_NAME=vibesdk-v2-workflows
